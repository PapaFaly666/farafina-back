# Port the HTTP server listens on (defaults to 3000).
PORT="3000"

# PostgreSQL connection string used by Prisma.
# Copy this file to .env and fill in your real credentials.
# In production use your Neon connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/farafina?schema=public"

# JWT signing secret for the dashboard authentication. Use a long random string.
JWT_SECRET="change-me-to-a-long-random-secret-string"
JWT_EXPIRES_IN="7d"

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS="http://localhost:5173"

# Credentials for the admin account created by `npm run prisma:seed`.
SEED_ADMIN_USERNAME="superadmin"
SEED_ADMIN_EMAIL="admin@farafina-cb.com"
SEED_ADMIN_PASSWORD="Farafina2026!"
SEED_ADMIN_NAME="Farafina Admin"

# Cloudinary (image storage) — get these from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (e-mail replies + newsletter campaigns) — https://resend.com
RESEND_API_KEY=""
# Sender address. Use a verified domain in production (e.g. contact@farafina-cb.com).
MAIL_FROM="Farafina Conseils & Business <onboarding@resend.dev>"

# SMTP fallback (Gmail) — used when Resend fails. Use a Gmail App Password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
